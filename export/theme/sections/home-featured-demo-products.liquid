{% if section.settings.season_banner != blank %}
  {% assign season_link = section.settings.season_banner_link | default: '/collections/all' %}
  <a href="{{ season_link }}" class="ballers-season-hero">
    {{ section.settings.season_banner | image_url: width: 2000 | image_tag: loading: 'eager', alt: section.settings.season_banner_alt, widths: '800, 1200, 1600, 2000', sizes: '100vw' }}
  </a>
  <style>
    .ballers-season-hero {
      display: block;
      width: 100%;
      line-height: 0;
      background: var(--pj-bg);
    }

    .ballers-season-hero img {
      display: block;
      width: 100%;
      height: auto;
      aspect-ratio: 1376 / 768;
      object-fit: cover;
    }

    .ballers-season-hero:focus-visible {
      outline: 3px solid var(--pj-accent);
      outline-offset: -6px;
    }
  </style>
{% endif %}

{%- assign season_collection = collections['עונת-2026-2027'] -%}
{%- assign retro_collection = collections['רטרו'] -%}
{%- assign winter_collection = collections['winter'] -%}
{%- assign newest = season_collection.products | sort: 'created_at' | reverse -%}
{%- assign winter_items = winter_collection.products | sort: 'created_at' | reverse -%}

<div class="pj-value" dir="rtl" lang="he">
  <div class="pj-value-item"><strong>14 יום</strong><span>להחזרה</span></div>
  <div class="pj-value-item"><strong>משלוח</strong><span>10–20 ₪ · חינם מעל 300 ₪</span></div>
  <div class="pj-value-item"><strong>3+1</strong><span>על כל האתר</span></div>
  <div class="pj-value-item"><strong>שם ומספר</strong><span>על כל חולצה</span></div>
</div>

{%- if winter_items.size > 0 -%}
  <a href="{{ winter_collection.url }}" class="pj-ticker" dir="rtl" lang="he" aria-label="קולקציית החורף, לכל חליפות החורף">
    <span class="pj-ticker-label">קולקציית חורף ❄️</span>
    <span class="pj-ticker-viewport" aria-hidden="true">
      <span class="pj-ticker-track">
        {%- for i in (1..2) -%}
          {%- for p in winter_items limit: 12 -%}
            <span class="pj-ticker-item">
              {%- if p.featured_image -%}
                <img src="{{ p.featured_image | image_url: width: 120 }}" alt="" loading="lazy" width="40" height="40">
              {%- endif -%}
              <span>{{ p.title }}</span>
            </span>
          {%- endfor -%}
        {%- endfor -%}
      </span>
    </span>
  </a>
{%- endif -%}

<section class="ballers-products-strip pj-home" dir="rtl" lang="he">

  <div class="pj-dark">
    <div class="ballers-container">

      {%- if season_collection != blank and season_collection.products_count > 0 -%}
        <div class="ballers-title-row pj-row-title">
          <span></span>
          <h2>חם עכשיו: עונת 2026/2027</h2>
          <span></span>
        </div>
        <a href="{{ season_collection.url }}" class="pj-see-all">לכל {{ season_collection.products_count }} החולצות ←</a>

        <div class="ballers-strip-wrap">
          <button class="ballers-arrow ballers-arrow-right" type="button" aria-label="ימינה"><span aria-hidden="true">‹</span></button>
          <div class="ballers-products-row" id="BallersProductsRow-{{ section.id }}-season">
            {%- comment -%} Famous clubs first, then the newest shirts. Suits are skipped. {%- endcomment -%}
            {%- assign famous = 'ריאל מדריד,ברצלונה,מנצ׳סטר יונייטד,מנצ׳סטר סיטי,ליברפול,ארסנל,צ׳לסי,פריז סן ז׳רמן,באיירן,מילאן,יובנטוס,אינטר,אתלטיקו,דורטמונד,טוטנהאם,ניוקאסל' | split: ',' -%}
            {%- assign hot_shown = 0 -%}
            {%- assign hot_ids = ',' -%}
            {%- comment -%} Real Madrid card is pinned to the away shirt (photo on the mannequin, matches the other cards) {%- endcomment -%}
            {%- assign hot_pin = all_products['חולצת-חוץ-ריאל-מדריד-26-27'] -%}
            {%- if hot_pin.id and hot_pin.available -%}
              {%- assign hot_ids = hot_ids | append: hot_pin.id | append: ',' -%}
              {%- assign hot_shown = 1 -%}
              {% render 'pj-product-card', p: hot_pin %}
            {%- endif -%}
            {%- for team in famous -%}
              {%- if team == 'ריאל מדריד' and hot_shown == 1 -%}{%- continue -%}{%- endif -%}
              {%- for p in season_collection.products -%}
                {%- if hot_shown >= 12 -%}{%- break -%}{%- endif -%}
                {%- assign hot_key = ',' | append: p.id | append: ',' -%}
                {%- if p.title contains team -%}
                  {%- unless hot_ids contains hot_key or p.title contains 'חליפת' -%}
                    {%- assign hot_ids = hot_ids | append: p.id | append: ',' -%}
                    {%- assign hot_shown = hot_shown | plus: 1 -%}
                    {% render 'pj-product-card', p: p %}
                    {%- break -%}
                  {%- endunless -%}
                {%- endif -%}
              {%- endfor -%}
            {%- endfor -%}
            {%- for p in newest -%}
              {%- if hot_shown >= 12 -%}{%- break -%}{%- endif -%}
              {%- assign hot_key = ',' | append: p.id | append: ',' -%}
              {%- unless hot_ids contains hot_key or p.title contains 'חליפת' -%}
                {%- assign hot_ids = hot_ids | append: p.id | append: ',' -%}
                {%- assign hot_shown = hot_shown | plus: 1 -%}
                {% render 'pj-product-card', p: p %}
              {%- endunless -%}
            {%- endfor -%}
          </div>
          <button class="ballers-arrow ballers-arrow-left" type="button" aria-label="שמאלה"><span aria-hidden="true">›</span></button>
        </div>
      {%- endif -%}

      {% render 'ballers-home-categories' %}

      <div class="pj-team" id="PjTeam-{{ section.id }}">
        <div class="ballers-title-row pj-row-title">
          <span></span>
          <h2>מה הקבוצה שלך?</h2>
          <span></span>
        </div>
        <p class="pj-team-sub">בוחרים פעם אחת, ומעכשיו החולצות של הקבוצה שלך יחכו לך כאן</p>

        <div class="pj-team-chips" role="group" aria-label="בחירת קבוצה">
          {%- assign teams = 'ריאל מדריד,ברצלונה,מנצ׳סטר יונייטד,מנצ׳סטר סיטי,ליברפול,ארסנל,צ׳לסי,מילאן,יובנטוס,אינטר,פריז,באיירן,ארגנטינה,ברזיל,בית״ר,מכבי' | split: ',' -%}
          {%- for t in teams -%}
            <button type="button" class="pj-team-chip" data-team="{{ t | escape }}" aria-pressed="false">{{ t }}</button>
          {%- endfor -%}
        </div>

        <div class="pj-team-result" hidden>
          <div class="pj-team-head">
            <h3 class="pj-team-title"></h3>
            <button type="button" class="pj-team-all pj-team-clear">✕ ביטול הבחירה</button>
          </div>
          <div class="ballers-strip-wrap">
            <div class="ballers-products-row pj-team-row"></div>
          </div>
        </div>
        {%- capture team_defs -%}ריאל מדריד=ריאל מדריד~ברצלונה=ברצלונה~מנצ׳סטר יונייטד=מנצ׳סטר יונייטד|מנצ'סטר יונייטד~מנצ׳סטר סיטי=מנצ׳סטר סיטי|מנצ'סטר סיטי~ליברפול=ליברפול~ארסנל=ארסנל~צ׳לסי=צ׳לסי|צ'לסי~מילאן=מילאן~יובנטוס=יובנטוס~אינטר=אינטר~פריז=פריז~באיירן=באיירן~ארגנטינה=ארגנטינה~ברזיל=ברזיל~בית״ר=בית״ר|ביתר|בית"ר~מכבי=מכבי{%- endcapture -%}
        {%- assign team_pool = collections['pj-teams'] -%}
        <script type="application/json" class="pj-team-data">{
          {%- paginate team_pool.products by 250 -%}
          {%- assign defs = team_defs | split: '~' -%}
          {%- for def in defs -%}
            {%- assign parts = def | split: '=' -%}
            {%- assign label = parts[0] -%}
            {%- assign variants = parts[1] | split: '|' -%}
            {{ label | json }}:[
            {%- assign n = 0 -%}
            {%- for p in team_pool.products -%}
              {%- if n >= 16 -%}{%- break -%}{%- endif -%}
              {%- unless p.available -%}{%- continue -%}{%- endunless -%}
              {%- if p.title contains 'מכנס' -%}{%- continue -%}{%- endif -%}
              {%- if label == 'אינטר' and p.title contains 'מיאמי' -%}{%- continue -%}{%- endif -%}
              {%- assign hit = false -%}
              {%- for v in variants -%}
                {%- if p.title contains v -%}{%- assign hit = true -%}{%- break -%}{%- endif -%}
              {%- endfor -%}
              {%- if hit -%}
                {%- if n > 0 -%},{%- endif -%}
                {%- assign n = n | plus: 1 -%}
                {%- assign img = '' -%}
                {%- if p.featured_image -%}{%- assign img = p.featured_image | image_url: width: 600 -%}{%- endif -%}
                {"u":{{ p.url | json }},"t":{{ p.title | json }},"i":{{ img | json }},"p":{{ p.price | money_without_currency | append: ' ₪' | json }}}
              {%- endif -%}
            {%- endfor -%}]{%- unless forloop.last -%},{%- endunless -%}
          {%- endfor -%}
          {%- endpaginate -%}
        }</script>
        <style>
          .pj-team-clear { background: none; border: 0; cursor: pointer; font: inherit; padding: 6px 0; }
          .pj-team-chip[aria-pressed="true"]::after { content: " ✕"; font-weight: 700; }
        </style>
      </div>


    </div>
  </div>

  <div class="ballers-container pj-light">

    {% render 'ballers-home-faq', section_id: section.id, part: 'gallery' %}

    <div class="pj-recent" id="PjRecent-{{ section.id }}" hidden>
      <div class="ballers-title-row pj-row-title">
        <span></span>
        <h2>הסתכלת על אלה</h2>
        <span></span>
      </div>
      <div class="ballers-strip-wrap">
        <div class="ballers-products-row pj-recent-row"></div>
      </div>
    </div>

    {%- if retro_collection != blank and retro_collection.products_count > 0 -%}
      <div class="ballers-title-row pj-row-title">
        <span></span>
        <h2>רטרו אגדי</h2>
        <span></span>
      </div>
      <a href="{{ retro_collection.url }}" class="pj-see-all">לכל {{ retro_collection.products_count }} חולצות הרטרו ←</a>

      <div class="ballers-strip-wrap">
        <button class="ballers-arrow ballers-arrow-right" type="button" aria-label="ימינה"><span aria-hidden="true">‹</span></button>
        <div class="ballers-products-row" id="BallersProductsRow-{{ section.id }}-retro">
          {%- for p in retro_collection.products limit: 12 -%}
            {% render 'pj-product-card', p: p %}
          {%- endfor -%}
        </div>
        <button class="ballers-arrow ballers-arrow-left" type="button" aria-label="שמאלה"><span aria-hidden="true">›</span></button>
      </div>
    {%- endif -%}

    {% render 'ballers-home-faq', section_id: section.id, part: 'faq' %}

  </div>
</section>

{% render 'ballers-home-css-products' %}
{% render 'ballers-home-css-categories' %}
{% render 'ballers-home-css-gallery' %}
{% render 'ballers-home-css-responsive' %}

<script>
  document.addEventListener('DOMContentLoaded', function () {
    var strip = document.querySelector('.ballers-products-strip');

    if (!strip) {
      return;
    }

    strip.querySelectorAll('.ballers-strip-wrap').forEach(function (wrap) {
      var row = wrap.querySelector('.ballers-products-row');

      if (!row) {
        return;
      }

      var rightButton = wrap.querySelector('.ballers-arrow-right');
      var leftButton = wrap.querySelector('.ballers-arrow-left');

      function amount() {
        var card = row.querySelector('.ballers-product-card');
        return card ? card.offsetWidth + 20 : 260;
      }

      if (leftButton) {
        leftButton.addEventListener('click', function () {
          row.scrollBy({ left: -amount(), behavior: 'smooth' });
        });
      }

      if (rightButton) {
        rightButton.addEventListener('click', function () {
          row.scrollBy({ left: amount(), behavior: 'smooth' });
        });
      }
    });

    var gallery = strip.querySelector('.ballers-customers-gallery');
    var pauseButton = strip.querySelector('.bcg-pause');

    if (gallery && pauseButton) {
      pauseButton.addEventListener('click', function () {
        var paused = gallery.classList.toggle('is-paused');
        pauseButton.setAttribute('aria-pressed', paused ? 'true' : 'false');
        pauseButton.textContent = paused ? 'המשך גלילה' : 'השהיית הגלילה';
      });
    }

    function escapeHtml(value) {
      return String(value || '').replace(/[&<>"']/g, function (c) {
        return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
      });
    }

    function cardHtml(item) {
      var image = item.image
        ? '<img src="' + escapeHtml(item.image) + '" alt="" loading="lazy">'
        : '<div class="ballers-image-placeholder">אין תמונה</div>';
      return '<article class="ballers-product-card">' +
        '<a href="' + escapeHtml(item.url) + '" class="ballers-image-box" tabindex="-1" aria-hidden="true">' + image + '</a>' +
        '<div class="ballers-card-info">' +
        '<h3><a href="' + escapeHtml(item.url) + '">' + escapeHtml(item.title) + '</a></h3>' +
        '<p>' + escapeHtml(item.price) + '</p>' +
        '<a href="' + escapeHtml(item.url) + '" class="ballers-buy-btn">לצפייה במוצר</a>' +
        '</div></article>';
    }

    function storageGet(key) {
      try { return localStorage.getItem(key); } catch (e) { return null; }
    }

    function storageSet(key, value) {
      try { localStorage.setItem(key, value); } catch (e) {}
    }

    /* recently viewed */
    var recent = document.getElementById('PjRecent-{{ section.id }}');
    if (recent) {
      var recentList = [];
      try { recentList = JSON.parse(storageGet('pj_recent') || '[]'); } catch (e) {}
      if (recentList.length > 0) {
        recent.querySelector('.pj-recent-row').innerHTML = recentList.slice(0, 10).map(function (x) {
          return cardHtml({ url: x.u, title: x.t, image: x.i, price: x.p ? x.p + ' ₪' : '' });
        }).join('');
        recent.hidden = false;
      }
    }

    /* my team */
    var team = document.getElementById('PjTeam-{{ section.id }}');
    if (team) {
      var chips = team.querySelectorAll('.pj-team-chip');
      var result = team.querySelector('.pj-team-result');
      var row = team.querySelector('.pj-team-row');
      var title = team.querySelector('.pj-team-title');
      var all = team.querySelector('.pj-team-clear');

      var teamData = {};
      try { teamData = JSON.parse(team.querySelector('.pj-team-data').textContent); } catch (e) {}

      function clearTeam() {
        chips.forEach(function (chip) { chip.setAttribute('aria-pressed', 'false'); });
        try { localStorage.removeItem('pj_team'); } catch (e) {}
        result.hidden = true;
        row.innerHTML = '';
      }

      function showTeam(name, scroll) {
        chips.forEach(function (chip) {
          chip.setAttribute('aria-pressed', chip.getAttribute('data-team') === name ? 'true' : 'false');
        });
        storageSet('pj_team', name);
        title.textContent = 'החולצות של ' + name;
        result.hidden = false;

        var products = teamData[name] || [];
        if (products.length === 0) {
          row.innerHTML = '<div class="pj-team-empty">כרגע אין במלאי חולצות של ' + escapeHtml(name) + '. שלחו לנו הודעה בוואטסאפ ונבדוק בשבילכם.</div>';
        } else {
          row.innerHTML = products.map(function (p) {
            return cardHtml({ url: p.u, title: p.t, image: p.i, price: p.p });
          }).join('');
          row.scrollLeft = 0;
        }

        if (scroll) {
          result.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        }
      }

      chips.forEach(function (chip) {
        chip.addEventListener('click', function () {
          if (chip.getAttribute('aria-pressed') === 'true') {
            clearTeam();
          } else {
            showTeam(chip.getAttribute('data-team'), true);
          }
        });
      });

      all.addEventListener('click', clearTeam);

      var saved = storageGet('pj_team');
      if (saved) {
        var match = Array.prototype.some.call(chips, function (chip) { return chip.getAttribute('data-team') === saved; });
        if (match) {
          showTeam(saved, false);
          team.parentNode.insertBefore(team, team.parentNode.firstChild);
        }
      }
    }
  });
</script>

{% schema %}
{
  "name": "Home products",
  "settings": [
    {
      "type": "image_picker",
      "id": "season_banner",
      "label": "באנר עונת 2026/2027 (מוצג מתחת לתפריט העליון)"
    },
    {
      "type": "text",
      "id": "season_banner_alt",
      "label": "תיאור הבאנר לקוראי מסך",
      "default": "עונת 2026/2027 יצאה לדרך, בואו להתחדש. שחקני כדורגל חוגגים באצטדיון."
    },
    {
      "type": "url",
      "id": "season_banner_link",
      "label": "קישור הבאנר (ברירת מחדל: כל המוצרים)"
    }
  ],
  "presets": [
    {
      "name": "Home products"
    }
  ]
}
{% endschema %}
