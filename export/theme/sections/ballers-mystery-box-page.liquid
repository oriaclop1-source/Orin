<section class="ballers-mystery-collection-page" dir="rtl">

  {% assign mystery_collection = collection %}

  {% if mystery_collection == blank or mystery_collection.products_count == 0 %}
    {% if collections['mystery-box'] != blank %}
      {% assign mystery_collection = collections['mystery-box'] %}
    {% elsif collections['מיסטרי-בוקס'] != blank %}
      {% assign mystery_collection = collections['מיסטרי-בוקס'] %}
    {% elsif collections['מיסטרי בוקס'] != blank %}
      {% assign mystery_collection = collections['מיסטרי בוקס'] %}
    {% endif %}
  {% endif %}

  <div class="ballers-mystery-collection-container">

    <header class="ballers-mystery-collection-hero">
      <div class="ballers-mystery-collection-eyebrow">
        MYSTERY BOX
      </div>

      <h1>
        מיסטרי בוקס
      </h1>

      <p>
        בוחרים סוג בוקס, מידה והעדפות — ואנחנו בוחרים עבורכם חולצה מפתיעה מתוך הקולקציה.
      </p>
    </header>

    {% if mystery_collection != blank and mystery_collection.products_count > 0 %}

      <div class="ballers-mystery-collection-toolbar">
        <div class="ballers-mystery-collection-count">
          {{ mystery_collection.products_count }} מוצרי מיסטרי בוקס
        </div>

        <a href="/" class="ballers-mystery-collection-back">
          חזרה לעמוד הבית
        </a>
      </div>

      {% paginate mystery_collection.products by 24 %}

        <div class="ballers-mystery-collection-grid" id="BallersMysteryGrid-{{ section.id }}">

          {% for product in mystery_collection.products %}

            <article class="ballers-mystery-collection-card{% if product.images[1] != blank %} has-hover-image{% endif %}">

              <a href="{{ product.url }}" class="ballers-mystery-collection-image-box" aria-label="{{ product.title | escape }}">

                {% if product.featured_image %}

                  {% assign second_image = product.images[1] %}

                  <img
                    src="{{ product.featured_image | image_url: width: 900 }}"
                    alt="{{ product.title | escape }}"
                    loading="lazy"
                    class="ballers-mystery-img-main"
                  >

                  {% if second_image != blank %}
                    <img
                      src="{{ second_image | image_url: width: 900 }}"
                      alt="{{ product.title | escape }}"
                      loading="lazy"
                      class="ballers-mystery-img-hover"
                    >
                  {% endif %}

                {% else %}
                  <div class="ballers-mystery-collection-no-image">
                    תמונה תתווסף בקרוב
                  </div>
                {% endif %}

              </a>

              <div class="ballers-mystery-collection-info">

                <h2>
                  <a href="{{ product.url }}">
                    {{ product.title }}
                  </a>
                </h2>

                <div class="ballers-mystery-collection-price">
                  {% if product.price_varies %}
                    החל מ־{{ product.price_min | money_without_currency }} ₪
                  {% else %}
                    {{ product.price | money_without_currency }} ₪
                  {% endif %}

                  {% if product.compare_at_price_max > product.price %}
                    <del>
                      {{ product.compare_at_price_max | money_without_currency }} ₪
                    </del>
                  {% endif %}
                </div>

                <div class="ballers-mystery-collection-desc">
                  {% if product.title contains 'רטרו' %}
                    בוקס הפתעה עם חולצת רטרו קלאסית ונוסטלגית.
                  {% elsif product.title contains 'ספיישל' %}
                    בוקס הפתעה עם חולצה מיוחדת בעיצוב נדיר.
                  {% elsif product.title contains 'עונה' or product.title contains '25/26' %}
                    בוקס הפתעה עם חולצה מעונת 25/26.
                  {% else %}
                    בוקס הפתעה עם חולצת כדורגל שנבחרת במיוחד עבורך.
                  {% endif %}
                </div>

                <a href="{{ product.url }}" class="ballers-mystery-collection-button">
                  לבחירת הבוקס
                </a>

              </div>

            </article>

          {% endfor %}

        </div>

        {% if paginate.pages > 1 %}
          <nav class="ballers-mystery-pagination" aria-label="עמודי מיסטרי בוקס">

            {% if paginate.previous %}
              <a href="{{ paginate.previous.url }}" class="ballers-mystery-page-link">
                הקודם
              </a>
            {% endif %}

            <span class="ballers-mystery-page-status">
              עמוד {{ paginate.current_page }} מתוך {{ paginate.pages }}
            </span>

            {% if paginate.next %}
              <a href="{{ paginate.next.url }}" class="ballers-mystery-page-link">
                הבא
              </a>
            {% endif %}

          </nav>
        {% endif %}

      {% endpaginate %}

    {% else %}

      <div class="ballers-mystery-empty">
        <h2>עדיין אין מוצרי מיסטרי בוקס</h2>
        <p>
          ודא שהמוצרים משויכים לקולקציית מיסטרי בוקס ושהקולקציה זמינה ב־Online Store.
        </p>
      </div>

    {% endif %}

  </div>

</section>

<style>

  .ballers-mystery-collection-page,
  .ballers-mystery-collection-page * {
    box-sizing: border-box;
    font-family: "Rubik", "Heebo", Arial, sans-serif !important;
  }

  .ballers-mystery-collection-page {
    width: 100%;
    direction: rtl;
    background:
      radial-gradient(circle at top right, rgba(0,0,0,0.045), transparent 34%),
      linear-gradient(180deg, #f5f6f7 0%, #ffffff 100%);
    padding: 34px 18px 64px;
    overflow: hidden;
  }

  .ballers-mystery-collection-container {
    width: 100%;
    max-width: 1500px;
    margin: 0 auto;
  }

  .ballers-mystery-collection-hero {
    position: relative;
    overflow: hidden;
    background: #101112;
    color: #ffffff;
    border-radius: 20px;
    padding: 36px 22px;
    text-align: center;
    margin-bottom: 26px;
    box-shadow: 0 16px 42px rgba(0,0,0,0.16);
    animation: mysteryCollectionFadeUp 0.5s ease both;
  }

  .ballers-mystery-collection-hero::before {
    content: "";
    position: absolute;
    top: -95px;
    left: -90px;
    width: 230px;
    height: 230px;
    border-radius: 999px;
    background: rgba(255,255,255,0.07);
  }

  .ballers-mystery-collection-hero::after {
    content: "";
    position: absolute;
    right: -110px;
    bottom: -130px;
    width: 280px;
    height: 280px;
    border-radius: 999px;
    background: rgba(255,255,255,0.045);
  }

  .ballers-mystery-collection-eyebrow {
    position: relative;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 10px;
    padding: 7px 14px;
    border-radius: 999px;
    border: 1px solid rgba(255,255,255,0.22);
    color: rgba(255,255,255,0.72);
    font-size: 12px;
    font-weight: 900;
    letter-spacing: 1.2px;
  }

  .ballers-mystery-collection-hero h1 {
    position: relative;
    z-index: 2;
    margin: 0 0 10px !important;
    color: #ffffff !important;
    font-size: clamp(38px, 5vw, 68px) !important;
    font-weight: 900 !important;
    line-height: 1.03 !important;
    letter-spacing: -1px !important;
  }

  .ballers-mystery-collection-hero p {
    position: relative;
    z-index: 2;
    max-width: 850px;
    margin: 0 auto !important;
    color: rgba(255,255,255,0.82);
    font-size: clamp(15px, 1.7vw, 21px);
    font-weight: 800;
    line-height: 1.55;
  }

  .ballers-mystery-collection-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    margin-bottom: 22px;
    animation: mysteryCollectionFadeUp 0.5s ease both;
    animation-delay: 0.06s;
  }

  .ballers-mystery-collection-count {
    color: #111111;
    font-size: 17px;
    font-weight: 900;
    background: #ffffff;
    border: 1px solid rgba(0,0,0,0.08);
    border-radius: 999px;
    padding: 10px 16px;
    box-shadow: 0 8px 22px rgba(0,0,0,0.06);
  }

  .ballers-mystery-collection-back {
    color: #111111 !important;
    text-decoration: none !important;
    font-size: 15px;
    font-weight: 900;
    background: #ffffff;
    border: 1px solid rgba(0,0,0,0.12);
    border-radius: 999px;
    padding: 10px 18px;
    box-shadow: 0 8px 22px rgba(0,0,0,0.06);
    transition:
      transform 0.22s ease,
      background 0.22s ease,
      color 0.22s ease,
      border-color 0.22s ease;
  }

  .ballers-mystery-collection-back:hover {
    transform: translateY(-2px);
    background: #111111;
    color: #ffffff !important;
    border-color: #111111;
  }

  .ballers-mystery-collection-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
  }

  .ballers-mystery-collection-card {
    background: #ffffff;
    border: 1px solid rgba(0,0,0,0.08);
    border-radius: 20px;
    overflow: hidden;
    min-height: 455px;
    display: flex;
    flex-direction: column;
    box-shadow: 0 12px 30px rgba(0,0,0,0.07);
    animation: mysteryCollectionCardIn 0.48s ease both;
    transition:
      transform 0.24s ease,
      box-shadow 0.24s ease,
      border-color 0.24s ease;
  }

  .ballers-mystery-collection-card:hover {
    transform: translateY(-7px);
    box-shadow: 0 22px 46px rgba(0,0,0,0.14);
    border-color: rgba(0,0,0,0.18);
  }

  .ballers-mystery-collection-image-box {
    position: relative;
    width: 100%;
    height: 330px;
    padding: 16px;
    background: linear-gradient(135deg, #eeeeee 0%, #ffffff 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    text-decoration: none !important;
  }

  .ballers-mystery-img-main,
  .ballers-mystery-img-hover {
    position: absolute;
    inset: 16px;
    width: calc(100% - 32px);
    height: calc(100% - 32px);
    object-fit: contain;
    display: block;
    transition: opacity 0.32s ease;
  }

  .ballers-mystery-img-main { opacity: 1; }
  .ballers-mystery-img-hover { opacity: 0; pointer-events: none; }

  @media screen and (max-width: 768px) {
    .ballers-mystery-img-hover { display: none; }
  }

  .ballers-mystery-collection-no-image {
    width: 100%;
    height: 100%;
    border: 2px dashed rgba(0,0,0,0.18);
    border-radius: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: rgba(0,0,0,0.50);
    font-size: 17px;
    font-weight: 900;
    text-align: center;
    padding: 18px;
  }

  .ballers-mystery-collection-info {
    padding: 18px 16px 20px;
    display: flex;
    flex-direction: column;
    flex: 1;
    text-align: center;
  }

  .ballers-mystery-collection-info h2 {
    margin: 0 0 12px !important;
    min-height: 46px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #000000 !important;
    font-size: 21px !important;
    font-weight: 900 !important;
    line-height: 1.18 !important;
    letter-spacing: -0.45px !important;
  }

  .ballers-mystery-collection-info h2 a {
    color: #000000 !important;
    text-decoration: none !important;
    font: inherit !important;
  }

  .ballers-mystery-collection-price {
    margin-bottom: 10px;
    min-height: 28px;
    color: #111111;
    font-size: 22px;
    font-weight: 900;
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: 8px;
    flex-wrap: wrap;
  }

  .ballers-mystery-collection-price del {
    color: rgba(0,0,0,0.36);
    font-size: 15px;
    font-weight: 800;
  }

  .ballers-mystery-collection-desc {
    margin: 0 auto 17px;
    color: rgba(0,0,0,0.62);
    font-size: 14px;
    font-weight: 800;
    line-height: 1.45;
    min-height: 40px;
    max-width: 330px;
  }

  .ballers-mystery-collection-button {
    margin-top: auto;
    width: 100%;
    min-height: 46px;
    border-radius: 12px;
    background: #111111;
    color: #ffffff !important;
    text-decoration: none !important;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 15px;
    font-weight: 900;
    box-shadow: 0 10px 22px rgba(0,0,0,0.16);
    transition:
      transform 0.22s ease,
      background 0.22s ease,
      box-shadow 0.22s ease;
  }

  .ballers-mystery-collection-button:hover {
    background: #2b2b2b;
    transform: translateY(-2px);
    box-shadow: 0 16px 30px rgba(0,0,0,0.22);
  }

  .ballers-mystery-pagination {
    margin-top: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
    flex-wrap: wrap;
  }

  .ballers-mystery-page-link {
    min-width: 96px;
    min-height: 42px;
    padding: 0 18px;
    border-radius: 10px;
    background: #111111;
    color: #ffffff !important;
    text-decoration: none !important;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 15px;
    font-weight: 900;
    transition:
      background 0.22s ease,
      transform 0.22s ease;
  }

  .ballers-mystery-page-link:hover {
    background: #2b2b2b;
    transform: translateY(-2px);
  }

  .ballers-mystery-page-status {
    color: #111111;
    font-size: 15px;
    font-weight: 900;
  }

  .ballers-mystery-empty {
    background: #ffffff;
    border: 1px solid rgba(0,0,0,0.08);
    border-radius: 18px;
    padding: 46px 20px;
    text-align: center;
    box-shadow: 0 12px 30px rgba(0,0,0,0.07);
  }

  .ballers-mystery-empty h2 {
    margin: 0 0 10px !important;
    color: #111111 !important;
    font-size: 26px !important;
    font-weight: 900 !important;
  }

  .ballers-mystery-empty p {
    margin: 0 auto !important;
    max-width: 760px;
    color: rgba(0,0,0,0.64);
    font-size: 16px;
    font-weight: 800;
    line-height: 1.5;
  }

  @keyframes mysteryCollectionFadeUp {
    from {
      opacity: 0;
      transform: translateY(16px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes mysteryCollectionCardIn {
    from {
      opacity: 0;
      transform: translateY(14px) scale(0.98);
    }

    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  @media screen and (max-width: 1180px) {
    .ballers-mystery-collection-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 20px;
    }

    .ballers-mystery-collection-image-box {
      height: 295px;
    }
  }

  @media screen and (max-width: 900px) {
    .ballers-mystery-collection-page {
      padding: 26px 14px 52px;
    }

    .ballers-mystery-collection-hero {
      padding: 30px 16px;
      border-radius: 17px;
      margin-bottom: 24px;
    }

    .ballers-mystery-collection-hero h1 {
      font-size: 40px !important;
      letter-spacing: -0.5px !important;
    }

    .ballers-mystery-collection-hero p {
      font-size: 15px;
      line-height: 1.55;
    }

    .ballers-mystery-collection-toolbar {
      flex-direction: column;
      text-align: center;
      justify-content: center;
      gap: 10px;
    }

    .ballers-mystery-collection-count {
      font-size: 15px;
    }

    .ballers-mystery-collection-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 16px;
    }

    .ballers-mystery-collection-card {
      border-radius: 16px;
      min-height: 390px;
    }

    .ballers-mystery-collection-image-box {
      height: 230px;
      padding: 13px;
    }

    .ballers-mystery-collection-info {
      padding: 14px 11px 15px;
    }

    .ballers-mystery-collection-info h2 {
      font-size: 16px !important;
      min-height: 42px;
    }

    .ballers-mystery-collection-price {
      font-size: 18px;
    }

    .ballers-mystery-collection-desc {
      font-size: 13px;
      min-height: auto;
    }

    .ballers-mystery-collection-button {
      min-height: 41px;
      font-size: 14px;
      border-radius: 10px;
    }
  }

  @media screen and (max-width: 520px) {
    .ballers-mystery-collection-page {
      padding: 20px 10px 42px;
    }

    .ballers-mystery-collection-hero {
      padding: 28px 13px;
      border-radius: 16px;
    }

    .ballers-mystery-collection-hero h1 {
      font-size: 34px !important;
      letter-spacing: -0.5px !important;
    }

    .ballers-mystery-collection-grid {
      grid-template-columns: 1fr;
      gap: 15px;
    }

    .ballers-mystery-collection-card {
      min-height: auto;
    }

    .ballers-mystery-collection-image-box {
      height: 300px;
    }

    .ballers-mystery-collection-info h2 {
      font-size: 19px !important;
      min-height: auto;
    }

    .ballers-mystery-collection-price {
      font-size: 21px;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    var grid = document.getElementById('BallersMysteryGrid-{{ section.id }}');
    if (!grid) return;

    var multiCards = Array.from(grid.querySelectorAll('.ballers-mystery-collection-card.has-hover-image'));
    if (multiCards.length === 0) return;

    var showingHover = multiCards.map(function () { return false; });

    setInterval(function () {
      multiCards.forEach(function (card, i) {
        var main  = card.querySelector('.ballers-mystery-img-main');
        var hover = card.querySelector('.ballers-mystery-img-hover');
        if (!main || !hover) return;

        showingHover[i] = !showingHover[i];
        main.style.opacity  = showingHover[i] ? '0' : '1';
        hover.style.opacity = showingHover[i] ? '1' : '0';
      });
    }, 2500);
  });
</script>

{% schema %}
{
  "name": "Mystery boxes",
  "settings": [],
  "presets": [
    {
      "name": "Mystery boxes"
    }
  ]
}
{% endschema %}