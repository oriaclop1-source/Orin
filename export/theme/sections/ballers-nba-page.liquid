<section class="ballers-nba-page" dir="rtl">

  {% assign nba_collection = collection %}

  <div class="ballers-nba-container">

    <header class="ballers-nba-hero">
      <div class="ballers-nba-eyebrow">NBA</div>

      <h1>NBA</h1>

      <p>
        קולקציית NBA — גופיות כדורסל, רטרו, קלאסיקות וספיישלים מהקבוצות הגדולות.
      </p>
    </header>

    {% if nba_collection != blank and nba_collection.products_count > 0 %}

      <div class="ballers-nba-toolbar">
        <div class="ballers-nba-count">
          {{ nba_collection.products_count }} מוצרים בקולקציית NBA
        </div>

        <a class="ballers-nba-back-home" href="/">
          חזרה לעמוד הבית
        </a>
      </div>

      {% paginate nba_collection.products by 96 %}

        <div class="ballers-nba-grid" id="BallersNbaGrid-{{ section.id }}">

          {% for product in nba_collection.products %}

            <article class="ballers-nba-card{% if product.images[1] != blank %} has-hover-image{% endif %}">

              <a href="{{ product.url }}" class="ballers-nba-image-box" aria-label="{{ product.title | escape }}">

                {% if product.featured_image != blank %}

                  {% assign second_image = product.images[1] %}

                  <img
                    src="{{ product.featured_image | image_url: width: 900 }}"
                    alt="{{ product.title | escape }}"
                    loading="lazy"
                    class="ballers-nba-img-main"
                  >

                  {% if second_image != blank %}
                    <img
                      src="{{ second_image | image_url: width: 900 }}"
                      alt="{{ product.title | escape }}"
                      loading="lazy"
                      class="ballers-nba-img-hover"
                    >
                  {% endif %}

                {% else %}
                  <div class="ballers-nba-no-image">
                    אין תמונה
                  </div>
                {% endif %}

              </a>

              <div class="ballers-nba-content">

                <h2 class="ballers-nba-title">
                  <a href="{{ product.url }}">
                    {{ product.title }}
                  </a>
                </h2>

                <div class="ballers-nba-price">
                  {% if product.price_varies %}
                    <span>החל מ־{{ product.price_min | money_without_currency }} ₪</span>
                  {% else %}
                    <span>{{ product.price | money_without_currency }} ₪</span>
                  {% endif %}

                  {% if product.compare_at_price_max > product.price %}
                    <del>{{ product.compare_at_price_max | money_without_currency }} ₪</del>
                  {% endif %}
                </div>

                <a href="{{ product.url }}" class="ballers-nba-button">
                  לצפייה במוצר
                </a>

              </div>

            </article>

          {% endfor %}

        </div>

        {% if paginate.pages > 1 %}
          <nav class="ballers-nba-pagination" aria-label="עמודי קולקציה">

            {% if paginate.previous %}
              <a href="{{ paginate.previous.url }}" class="ballers-nba-page-link">
                הקודם
              </a>
            {% endif %}

            <span class="ballers-nba-page-status">
              עמוד {{ paginate.current_page }} מתוך {{ paginate.pages }}
            </span>

            {% if paginate.next %}
              <a href="{{ paginate.next.url }}" class="ballers-nba-page-link">
                הבא
              </a>
            {% endif %}

          </nav>
        {% endif %}

      {% endpaginate %}

    {% else %}

      <div class="ballers-nba-empty">
        <h2>לא נמצאו מוצרים בקולקציית NBA</h2>
        <p>
          בדוק שהקולקציה קיימת, שיש בה מוצרים, ושהיא מחוברת לתבנית nba.
        </p>
      </div>

    {% endif %}

  </div>

</section>

<style>
  .ballers-nba-page,
  .ballers-nba-page * {
    box-sizing: border-box;
    font-family: "Rubik", "Heebo", Arial, sans-serif !important;
  }

  .ballers-nba-page {
    width: 100%;
    background:
      radial-gradient(circle at top right, rgba(0,0,0,0.045), transparent 34%),
      linear-gradient(180deg, #f5f5f5 0%, #ffffff 100%);
    padding: 34px 18px 64px;
    overflow: hidden;
  }

  .ballers-nba-container {
    width: 100%;
    max-width: 1500px;
    margin: 0 auto;
  }

  .ballers-nba-hero {
    position: relative;
    overflow: hidden;
    background: #101112;
    color: #ffffff;
    border-radius: 20px;
    padding: 34px 22px;
    text-align: center;
    margin-bottom: 26px;
    box-shadow: 0 16px 42px rgba(0,0,0,0.16);
    animation: ballersNbaFadeUp 0.5s ease both;
  }

  .ballers-nba-hero::before {
    content: "";
    position: absolute;
    top: -95px;
    left: -90px;
    width: 230px;
    height: 230px;
    border-radius: 999px;
    background: rgba(255,255,255,0.07);
  }

  .ballers-nba-hero::after {
    content: "";
    position: absolute;
    right: -110px;
    bottom: -130px;
    width: 280px;
    height: 280px;
    border-radius: 999px;
    background: rgba(255,255,255,0.045);
  }

  .ballers-nba-eyebrow {
    position: relative;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 10px;
    padding: 7px 14px;
    border-radius: 999px;
    border: 1px solid rgba(255,255,255,0.22);
    color: rgba(255,255,255,0.72);
    font-size: 12px;
    font-weight: 900;
    letter-spacing: 1.2px;
  }

  .ballers-nba-hero h1 {
    position: relative;
    z-index: 2;
    margin: 0 0 10px !important;
    color: #ffffff !important;
    font-size: clamp(34px, 4.5vw, 58px) !important;
    font-weight: 900 !important;
    line-height: 1.05 !important;
    letter-spacing: -1px !important;
  }

  .ballers-nba-hero p {
    position: relative;
    z-index: 2;
    max-width: 900px;
    margin: 0 auto !important;
    color: rgba(255,255,255,0.82);
    font-size: clamp(15px, 1.7vw, 21px);
    font-weight: 800;
    line-height: 1.55;
  }

  .ballers-nba-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    margin-bottom: 22px;
    animation: ballersNbaFadeUp 0.5s ease both;
    animation-delay: 0.06s;
  }

  .ballers-nba-count {
    color: #111111;
    font-size: 17px;
    font-weight: 900;
  }

  .ballers-nba-back-home {
    color: #111111 !important;
    text-decoration: none !important;
    font-size: 15px;
    font-weight: 900;
    padding-bottom: 5px;
    border-bottom: 3px solid #111111;
    transition:
      transform 0.22s ease,
      color 0.22s ease,
      border-color 0.22s ease;
  }

  .ballers-nba-back-home:hover {
    color: #555555 !important;
    border-color: #555555;
    transform: translateY(-2px);
  }

  .ballers-nba-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 22px;
  }

  .ballers-nba-card {
    background: #ffffff;
    border: 1px solid rgba(0,0,0,0.08);
    border-radius: 18px;
    overflow: hidden;
    min-height: 440px;
    display: flex;
    flex-direction: column;
    box-shadow: 0 12px 30px rgba(0,0,0,0.07);
    animation: ballersNbaCardIn 0.48s ease both;
    transition:
      transform 0.24s ease,
      box-shadow 0.24s ease,
      border-color 0.24s ease,
      background 0.24s ease;
  }

  .ballers-nba-card:hover {
    transform: translateY(-7px);
    box-shadow: 0 22px 46px rgba(0,0,0,0.14);
    border-color: rgba(0,0,0,0.18);
  }

  .ballers-nba-image-box {
    position: relative;
    width: 100%;
    height: 285px;
    padding: 16px;
    background: linear-gradient(135deg, #eeeeee 0%, #ffffff 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    text-decoration: none;
  }

  .ballers-nba-img-main,
  .ballers-nba-img-hover {
    position: absolute;
    inset: 16px;
    width: calc(100% - 32px);
    height: calc(100% - 32px);
    object-fit: contain;
    display: block;
    transition: opacity 0.32s ease;
  }

  .ballers-nba-img-main {
    opacity: 1;
  }

  .ballers-nba-img-hover {
    opacity: 0;
    pointer-events: none;
  }

  @media screen and (max-width: 768px) {
    .ballers-nba-img-hover {
      display: none;
    }
  }

  .ballers-nba-no-image {
    color: rgba(0,0,0,0.55);
    font-size: 18px;
    font-weight: 900;
  }

  .ballers-nba-content {
    padding: 17px 15px 19px;
    display: flex;
    flex-direction: column;
    flex: 1;
    text-align: center;
  }

  .ballers-nba-title {
    margin: 0 0 12px !important;
    min-height: 56px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #000000 !important;
    font-size: 18px !important;
    font-weight: 900 !important;
    line-height: 1.18 !important;
    letter-spacing: -0.45px !important;
  }

  .ballers-nba-title a {
    color: #000000 !important;
    text-decoration: none !important;
    font: inherit !important;
    transition: color 0.2s ease;
  }

  .ballers-nba-card:hover .ballers-nba-title a {
    color: #333333 !important;
  }

  .ballers-nba-price {
    margin-bottom: 17px;
    min-height: 27px;
    color: #111111;
    font-size: 19px;
    font-weight: 900;
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: 8px;
    flex-wrap: wrap;
  }

  .ballers-nba-price del {
    color: rgba(0,0,0,0.36);
    font-size: 14px;
    font-weight: 800;
  }

  .ballers-nba-button {
    margin-top: auto;
    width: 100%;
    min-height: 45px;
    border-radius: 12px;
    background: #111111;
    color: #ffffff !important;
    text-decoration: none !important;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 15px;
    font-weight: 900;
    box-shadow: 0 10px 22px rgba(0,0,0,0.16);
    transition:
      transform 0.22s ease,
      background 0.22s ease,
      box-shadow 0.22s ease;
  }

  .ballers-nba-button:hover {
    background: #2b2b2b;
    transform: translateY(-2px);
    box-shadow: 0 16px 30px rgba(0,0,0,0.22);
  }

  .ballers-nba-pagination {
    margin-top: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
    flex-wrap: wrap;
  }

  .ballers-nba-page-link {
    min-width: 96px;
    min-height: 42px;
    padding: 0 18px;
    border-radius: 10px;
    background: #111111;
    color: #ffffff !important;
    text-decoration: none !important;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 15px;
    font-weight: 900;
    transition:
      background 0.22s ease,
      transform 0.22s ease;
  }

  .ballers-nba-page-link:hover {
    background: #2b2b2b;
    transform: translateY(-2px);
  }

  .ballers-nba-page-status {
    color: #111111;
    font-size: 15px;
    font-weight: 900;
  }

  .ballers-nba-empty {
    background: #ffffff;
    border: 1px solid rgba(0,0,0,0.08);
    border-radius: 18px;
    padding: 46px 20px;
    text-align: center;
    box-shadow: 0 12px 30px rgba(0,0,0,0.07);
  }

  .ballers-nba-empty h2 {
    margin: 0 0 10px !important;
    color: #111111 !important;
    font-size: 26px !important;
    font-weight: 900 !important;
  }

  .ballers-nba-empty p {
    margin: 0 auto !important;
    max-width: 760px;
    color: rgba(0,0,0,0.64);
    font-size: 16px;
    font-weight: 800;
    line-height: 1.5;
  }

  body.ballers-site-dark .ballers-nba-page {
    background: #070707 !important;
    color: #ffffff !important;
  }

  body.ballers-site-dark .ballers-nba-card,
  body.ballers-site-dark .ballers-nba-empty {
    background: #151515 !important;
    color: #ffffff !important;
    border-color: rgba(255,255,255,0.12) !important;
    box-shadow: 0 14px 32px rgba(0,0,0,0.42) !important;
  }

  body.ballers-site-dark .ballers-nba-image-box {
    background: #1f1f1f !important;
  }

  body.ballers-site-dark .ballers-nba-count,
  body.ballers-site-dark .ballers-nba-back-home,
  body.ballers-site-dark .ballers-nba-title,
  body.ballers-site-dark .ballers-nba-title a,
  body.ballers-site-dark .ballers-nba-price,
  body.ballers-site-dark .ballers-nba-page-status,
  body.ballers-site-dark .ballers-nba-empty h2,
  body.ballers-site-dark .ballers-nba-empty p,
  body.ballers-site-dark .ballers-nba-no-image {
    color: #ffffff !important;
  }

  body.ballers-site-dark .ballers-nba-price del {
    color: rgba(255,255,255,0.45) !important;
  }

  body.ballers-site-dark .ballers-nba-back-home {
    border-bottom-color: #ffffff !important;
  }

  body.ballers-site-dark .ballers-nba-button,
  body.ballers-site-dark .ballers-nba-page-link {
    background: #ffffff !important;
    color: #000000 !important;
  }

  body.ballers-site-dark .ballers-nba-button:hover,
  body.ballers-site-dark .ballers-nba-page-link:hover {
    background: #e6e6e6 !important;
    color: #000000 !important;
  }

  @keyframes ballersNbaFadeUp {
    from {
      opacity: 0;
      transform: translateY(16px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes ballersNbaCardIn {
    from {
      opacity: 0;
      transform: translateY(14px) scale(0.98);
    }

    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  @media screen and (max-width: 1250px) {
    .ballers-nba-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .ballers-nba-image-box {
      height: 270px;
    }
  }

  @media screen and (max-width: 860px) {
    .ballers-nba-page {
      padding: 26px 14px 52px;
    }

    .ballers-nba-hero {
      padding: 30px 16px;
      border-radius: 17px;
      margin-bottom: 24px;
    }

    .ballers-nba-hero h1 {
      font-size: 38px !important;
      letter-spacing: -0.5px !important;
    }

    .ballers-nba-hero p {
      font-size: 15px;
      line-height: 1.55;
    }

    .ballers-nba-toolbar {
      flex-direction: column;
      text-align: center;
      justify-content: center;
      gap: 10px;
    }

    .ballers-nba-count {
      font-size: 15px;
    }

    .ballers-nba-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 16px;
    }

    .ballers-nba-card {
      border-radius: 16px;
      min-height: 380px;
    }

    .ballers-nba-image-box {
      height: 220px;
      padding: 13px;
    }

    .ballers-nba-content {
      padding: 14px 11px 15px;
    }

    .ballers-nba-title {
      font-size: 15.5px !important;
      min-height: 48px;
    }

    .ballers-nba-price {
      font-size: 16px;
      margin-bottom: 13px;
    }

    .ballers-nba-button {
      min-height: 41px;
      font-size: 14px;
      border-radius: 10px;
    }
  }

  @media screen and (max-width: 520px) {
    .ballers-nba-page {
      padding: 20px 10px 42px;
    }

    .ballers-nba-hero {
      padding: 28px 13px;
      border-radius: 16px;
    }

    .ballers-nba-hero h1 {
      font-size: 34px !important;
      letter-spacing: -0.5px !important;
    }

    .ballers-nba-grid {
      grid-template-columns: 1fr;
      gap: 15px;
    }

    .ballers-nba-card {
      min-height: auto;
    }

    .ballers-nba-image-box {
      height: 300px;
    }

    .ballers-nba-title {
      font-size: 18px !important;
      min-height: auto;
    }

    .ballers-nba-price {
      font-size: 19px;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    var grid = document.getElementById('BallersNbaGrid-{{ section.id }}');

    if (!grid) {
      return;
    }

    var multiCards = Array.from(grid.querySelectorAll('.ballers-nba-card.has-hover-image'));

    if (multiCards.length === 0) {
      return;
    }

    var showingHover = multiCards.map(function () {
      return false;
    });

    setInterval(function () {
      multiCards.forEach(function (card, i) {
        var main = card.querySelector('.ballers-nba-img-main');
        var hover = card.querySelector('.ballers-nba-img-hover');

        if (!main || !hover) {
          return;
        }

        showingHover[i] = !showingHover[i];
        main.style.opacity = showingHover[i] ? '0' : '1';
        hover.style.opacity = showingHover[i] ? '1' : '0';
      });
    }, 2500);
  });
</script>

{% schema %}
{
  "name": "Ballers NBA Page",
  "settings": [],
  "presets": [
    {
      "name": "Ballers NBA Page"
    }
  ]
}
{% endschema %}