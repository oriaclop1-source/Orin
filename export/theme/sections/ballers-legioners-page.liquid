<section class="ballers-legioners-page" dir="rtl">

  {% assign legioners_collection = collections['ליגיונרים'] %}
  {% if legioners_collection == blank %}
    {% assign legioners_collection = collections['לגיונרים'] %}
  {% endif %}
  {% if legioners_collection == blank %}
    {% assign legioners_collection = collections['legioners'] %}
  {% endif %}
  {% if legioners_collection == blank %}
    {% assign legioners_collection = collections['legionnaires'] %}
  {% endif %}

  <div class="ballers-legioners-container">

    <div class="ballers-legioners-hero">
      <h1>ליגיונרים</h1>
      <p>החולצות של השחקנים הישראלים מעבר לים</p>
    </div>

    {% if legioners_collection != blank and legioners_collection.products_count > 0 %}

      <div class="ballers-legioners-grid">

        {% for product in legioners_collection.products limit: 100 %}
          <article class="ballers-legioners-card">

            <a href="{{ product.url }}" class="ballers-legioners-image">
              {% if product.featured_image %}
                <img
                  src="{{ product.featured_image | image_url: width: 900 }}"
                  alt="{{ product.title | escape }}"
                  loading="lazy"
                >
              {% else %}
                <div class="ballers-legioners-placeholder">אין תמונה</div>
              {% endif %}
            </a>

            <div class="ballers-legioners-info">
              <h2>
                <a href="{{ product.url }}">{{ product.title }}</a>
              </h2>

              <p class="ballers-legioners-price">
                {% if product.price_varies %}
                  החל מ- {{ product.price_min | money_without_currency }} ₪
                {% else %}
                  {{ product.price | money_without_currency }} ₪
                {% endif %}
              </p>

              <a href="{{ product.url }}" class="ballers-legioners-btn">
                לצפייה במוצר
              </a>
            </div>

          </article>
        {% endfor %}

      </div>

    {% else %}

      <div class="ballers-legioners-empty">
        <h2>עדיין לא נוספו מוצרים לליגיונרים</h2>
        <p>כדי שהעמוד יציג מוצרים, צור קולקציה בשם ליגיונרים והוסף אליה מוצרים.</p>
      </div>

    {% endif %}

  </div>

</section>

<style>
  .ballers-legioners-page,
  .ballers-legioners-page * {
    box-sizing: border-box;
    font-family: "Rubik", "Heebo", Arial, sans-serif !important;
  }

  .ballers-legioners-page {
    width: 100%;
    background: #ffffff;
    padding: 46px 22px 70px;
    color: #000;
  }

  .ballers-legioners-container {
    width: 100%;
    max-width: 1500px;
    margin: 0 auto;
  }

  .ballers-legioners-hero {
    text-align: center;
    margin-bottom: 42px;
  }

  .ballers-legioners-hero h1 {
    margin: 0 0 12px !important;
    padding: 0 !important;
    font-size: clamp(42px, 6vw, 82px) !important;
    line-height: 0.95 !important;
    font-weight: 950 !important;
    letter-spacing: -2.5px !important;
    color: #000 !important;
  }

  .ballers-legioners-hero p {
    margin: 0 !important;
    font-size: 21px !important;
    line-height: 1.35 !important;
    font-weight: 800 !important;
    color: #222 !important;
  }

  .ballers-legioners-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 26px;
    width: 100%;
  }

  .ballers-legioners-card {
    background: #fff;
    border-radius: 24px;
    padding: 14px 14px 18px;
    border: 1px solid rgba(0,0,0,0.08);
    box-shadow: 0 12px 28px rgba(0,0,0,0.08);
    text-align: center;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 430px;
    transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
  }

  .ballers-legioners-card:hover {
    transform: translateY(-7px) scale(1.015);
    box-shadow: 0 22px 48px rgba(0,0,0,0.16);
    border-color: rgba(0,0,0,0.16);
  }

  .ballers-legioners-image {
    width: 100%;
    height: 235px;
    border-radius: 18px;
    background: #f2f4f7;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    text-decoration: none !important;
    margin-bottom: 16px;
  }

  .ballers-legioners-image img {
    display: block;
    max-width: 96%;
    max-height: 96%;
    object-fit: contain;
    transition: transform 0.25s ease, filter 0.25s ease;
  }

  .ballers-legioners-card:hover .ballers-legioners-image img {
    transform: scale(1.06);
    filter: drop-shadow(0 12px 14px rgba(0,0,0,0.18));
  }

  .ballers-legioners-placeholder {
    color: #333;
    font-size: 18px;
    font-weight: 900;
  }

  .ballers-legioners-info {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
    min-height: 150px;
  }

  .ballers-legioners-info h2 {
    min-height: 56px;
    margin: 0 0 10px !important;
    padding: 0 !important;
    font-size: 18px !important;
    line-height: 1.18 !important;
    font-weight: 950 !important;
    letter-spacing: -0.4px !important;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ballers-legioners-info h2 a {
    color: #000 !important;
    text-decoration: none !important;
    font: inherit !important;
  }

  .ballers-legioners-price {
    margin: 0 0 14px !important;
    color: #000 !important;
    font-size: 18px !important;
    font-weight: 950 !important;
    line-height: 1.1 !important;
  }

  .ballers-legioners-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    max-width: 180px;
    min-height: 40px;
    padding: 0 18px;
    border-radius: 999px;
    background: #000;
    color: #fff !important;
    text-decoration: none !important;
    font-size: 14px;
    font-weight: 950;
    box-shadow: 0 9px 20px rgba(0,0,0,0.22);
    transition: transform 0.22s ease, box-shadow 0.22s ease;
  }

  .ballers-legioners-btn:hover {
    transform: translateY(-3px) scale(1.03);
    box-shadow: 0 14px 30px rgba(0,0,0,0.32);
  }

  .ballers-legioners-empty {
    max-width: 760px;
    margin: 0 auto;
    text-align: center;
    background: #f5f6f8;
    border-radius: 24px;
    padding: 38px 24px;
    border: 1px solid rgba(0,0,0,0.08);
  }

  .ballers-legioners-empty h2 {
    margin: 0 0 10px !important;
    font-size: 28px !important;
    font-weight: 950 !important;
    color: #000 !important;
  }

  .ballers-legioners-empty p {
    margin: 0 !important;
    font-size: 18px !important;
    font-weight: 700 !important;
    color: #333 !important;
  }

  @media screen and (max-width: 1200px) {
    .ballers-legioners-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 22px;
    }
  }

  @media screen and (max-width: 850px) {
    .ballers-legioners-page {
      padding: 34px 14px 58px;
    }

    .ballers-legioners-hero {
      margin-bottom: 30px;
    }

    .ballers-legioners-hero h1 {
      font-size: 46px !important;
      letter-spacing: -1.5px !important;
    }

    .ballers-legioners-hero p {
      font-size: 18px !important;
    }

    .ballers-legioners-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 16px;
    }

    .ballers-legioners-card {
      min-height: 365px;
      border-radius: 20px;
      padding: 11px 10px 15px;
    }

    .ballers-legioners-image {
      height: 180px;
      border-radius: 15px;
      margin-bottom: 13px;
    }

    .ballers-legioners-info {
      min-height: 140px;
    }

    .ballers-legioners-info h2 {
      min-height: 52px;
      font-size: 15.5px !important;
      line-height: 1.15 !important;
    }

    .ballers-legioners-price {
      font-size: 16px !important;
      margin-bottom: 12px !important;
    }

    .ballers-legioners-btn {
      min-height: 36px;
      max-width: 155px;
      font-size: 13px;
    }
  }

  @media screen and (max-width: 520px) {
    .ballers-legioners-page {
      padding: 28px 10px 48px;
    }

    .ballers-legioners-hero h1 {
      font-size: 40px !important;
    }

    .ballers-legioners-hero p {
      font-size: 16px !important;
    }

    .ballers-legioners-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px;
    }

    .ballers-legioners-card {
      min-height: 330px;
      border-radius: 18px;
      padding: 9px 8px 13px;
    }

    .ballers-legioners-image {
      height: 145px;
      border-radius: 14px;
    }

    .ballers-legioners-info {
      min-height: 135px;
    }

    .ballers-legioners-info h2 {
      font-size: 14px !important;
      min-height: 50px;
      margin-bottom: 8px !important;
    }

    .ballers-legioners-price {
      font-size: 15px !important;
    }

    .ballers-legioners-btn {
      max-width: 140px;
      min-height: 34px;
      font-size: 12px;
    }
  }
</style>

{% schema %}
{
  "name": "Ballers Legioners Page",
  "settings": [],
  "presets": [
    {
      "name": "Ballers Legioners Page"
    }
  ]
}
{% endschema %}