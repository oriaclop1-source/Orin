    color: #111111;
  }

  .ballers-service-box h3 {
    margin: 0 0 9px !important;
    color: #111111 !important;
    font-size: 19px !important;
    font-weight: 900 !important;
  }

  .ballers-service-box p {
    margin: 0 0 7px !important;
    color: rgba(0,0,0,0.72);
    font-size: 15px;
    font-weight: 700;
    line-height: 1.5;
  }

  .ballers-service-box p:last-child {
    margin-bottom: 0 !important;
  }

  .ballers-related-section {
    margin-top: 58px;
  }

  .ballers-related-title-wrap {
    text-align: center;
    margin-bottom: 24px;
  }

  .ballers-related-title-wrap h2 {
    margin: 0 0 8px !important;
    color: #111111 !important;
    font-size: clamp(28px, 3vw, 42px) !important;
    font-weight: 900 !important;
    line-height: 1.05 !important;
  }

  .ballers-related-title-wrap p {
    margin: 0 !important;
    color: rgba(0,0,0,0.58);
    font-size: 16px;
    font-weight: 800;
  }

  .ballers-related-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 20px;
  }

  .ballers-related-card {
    background: #ffffff;
    border: 1px solid rgba(0,0,0,0.08);
    border-radius: 18px;
    overflow: hidden;
    box-shadow: 0 12px 28px rgba(0,0,0,0.07);
    display: flex;
    flex-direction: column;
    transition: transform 0.24s ease, box-shadow 0.24s ease;
  }

  .ballers-related-card:hover {
    transform: translateY(-7px);
    box-shadow: 0 20px 42px rgba(0,0,0,0.13);
  }

  .ballers-related-image {
    height: 240px;
    background: #f2f4f5;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 16px;
    text-decoration: none;
  }

  .ballers-related-image img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
    transition: transform 0.28s ease;
  }

  .ballers-related-card:hover .ballers-related-image img {
    transform: scale(1.055);
  }

  .ballers-related-no-image {
    color: rgba(0,0,0,0.45);
    font-weight: 900;
  }

  .ballers-related-info {
    padding: 15px;
    text-align: center;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .ballers-related-info h3 {
    margin: 0 0 10px !important;
    min-height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #111111 !important;
    font-size: 16px !important;
    font-weight: 900 !important;
    line-height: 1.2 !important;
  }

  .ballers-related-info h3 a {
    color: inherit !important;
    text-decoration: none !important;
  }

  .ballers-related-price {
    color: #111111;
    font-size: 16px;
    font-weight: 900;
    margin-bottom: 14px;
  }

  .ballers-related-btn {
    margin-top: auto;
    min-height: 40px;
    border-radius: 11px;
    background: #111111;
    color: #ffffff !important;
    text-decoration: none !important;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 14px;
    font-weight: 900;
    transition: background 0.2s ease, transform 0.2s ease;
  }

  .ballers-related-btn:hover {
    background: #2f7f6f;
    transform: translateY(-2px);
  }

  .ballers-image-modal,
  .ballers-size-modal {
    position: fixed;
    inset: 0;
    z-index: 999999;
    background: rgba(0,0,0,0.86);
    display: none;
    align-items: center;
    justify-content: center;
    padding: 18px;
  }

  .ballers-image-modal.open,
  .ballers-size-modal.open {
    display: flex;
  }

  .ballers-image-modal-inner {
    width: min(1050px, 96vw);
    height: min(88vh, 900px);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ballers-image-modal-inner img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    display: block;
    background: #ffffff;
    border-radius: 18px;
    padding: 18px;
    box-shadow: 0 24px 70px rgba(0,0,0,0.45);
  }

  .ballers-image-modal-close,
  .ballers-size-close {
    position: fixed;
    top: 18px;
    left: 18px;
    width: 42px;
    height: 42px;
    border: none;
    border-radius: 999px;
    background: #ffffff;
    color: #111111;
    font-size: 30px;
    font-weight: 900;
    cursor: pointer;
    line-height: 1;
    z-index: 1000000;
  }

  .ballers-size-modal {
    background: rgba(0,0,0,0.72);
  }

  .ballers-size-modal-content {
    position: relative;
    width: min(900px, 96vw);
    max-height: 90vh;
    overflow: auto;
    background: #ffffff;
    border-radius: 18px;
    padding: 22px;
    box-shadow: 0 24px 60px rgba(0,0,0,0.32);
    text-align: center;
  }

  .ballers-size-modal-content h3 {
    margin: 0 0 16px !important;
    color: #111111 !important;
    font-size: 24px !important;
    font-weight: 900 !important;
  }

  .ballers-size-modal-content img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 12px;
  }

  @keyframes ballersFadeUp {
    from {
      opacity: 0;
      transform: translateY(18px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media screen and (max-width: 1050px) {
    .ballers-product-grid {
      grid-template-columns: 1fr;
    }

    .ballers-product-info {
      position: relative;
      top: auto;
    }

    .ballers-main-image-box {
      min-height: 480px;
    }

    .ballers-related-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media screen and (max-width: 620px) {
    .ballers-product-page {
      padding: 24px 10px 50px;
    }

    .ballers-main-image-box {
      min-height: 360px;
      border-radius: 16px;
      padding: 14px;
    }

    .ballers-zoom-hint {
      opacity: 1;
      transform: translateY(0);
      left: 12px;
      bottom: 12px;
      font-size: 12px;
      padding: 7px 11px;
    }

    .ballers-product-info {
      border-radius: 16px;
      padding: 18px;
    }

    .ballers-product-title {
      font-size: 28px !important;
    }

    .ballers-product-price {
      font-size: 24px;
    }

    .ballers-size-buttons {
      grid-template-columns: 1fr;
    }

    .ballers-related-grid {
      grid-template-columns: 1fr;
    }

    .ballers-related-image {
      height: 280px;
    }

    .ballers-size-modal-content {
      padding: 18px 12px;
    }

    .ballers-image-modal-inner img {
      padding: 10px;
      border-radius: 14px;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    var section = document.querySelector('.ballers-training-product-page');

    if (!section) {
      return;
    }

    var variants = {{ product.variants | json }};
    var productHasOnlyDefaultVariant = {{ product.has_only_default_variant | json }};
    var optionButtons = section.querySelectorAll('.ballers-option-btn');
    var optionGroups = section.querySelectorAll('.ballers-option-values');
    var variantInput = section.querySelector('#BallersVariantId');
    var priceBox = section.querySelector('#BallersProductPrice');
    var addButton = section.querySelector('.ballers-add-to-cart');
    var requiredMessage = section.querySelector('#BallersRequiredMessage');
    var productForm = section.querySelector('#BallersProductForm');

    function getSelectedOptionsMap() {
      var selected = {};

      optionGroups.forEach(function (group) {
        var position = Number(group.getAttribute('data-option-position')) - 1;
        var active = group.querySelector('.ballers-option-btn.active');

        selected[position] = active ? active.getAttribute('data-option-value') : null;
      });

      return selected;
    }

    function hasAnySelection() {
      var selectedMap = getSelectedOptionsMap();

      return Object.keys(selectedMap).some(function (key) {
        return selectedMap[key] !== null && selectedMap[key] !== '';
      });
    }

    function allVisibleOptionsSelected() {
      if (productHasOnlyDefaultVariant) {
        return true;
      }

      var selectedMap = getSelectedOptionsMap();
      var keys = Object.keys(selectedMap);

      return keys.length > 0 && keys.every(function (key) {
        return selectedMap[key] !== null && selectedMap[key] !== '';
      });
    }

    function formatPrice(cents) {
      return (cents / 100).toFixed(2).replace('.00', '') + ' ₪';
    }

    function isNoPatchValue(value) {
      if (!value) {
        return false;
      }

      var normalized = String(value).toLowerCase();

      return (
        normalized.indexOf('ללא') !== -1 ||
        normalized.indexOf('בלי') !== -1 ||
        normalized.indexOf('no patch') !== -1 ||
        normalized.indexOf('no') !== -1
      );
    }

    function variantMatchesVisibleOptions(variant, selectedMap) {
      return Object.keys(selectedMap).every(function (key) {
        var selectedValue = selectedMap[key];

        if (selectedValue === null || selectedValue === '') {
          return true;
        }

        return variant.options[Number(key)] === selectedValue;
      });
    }

    function preferVariant(variantsList) {
      if (!variantsList || variantsList.length === 0) {
        return null;
      }

      var availableNoPatch = variantsList.find(function (variant) {
        return variant.available && variant.options.some(isNoPatchValue);
      });

      if (availableNoPatch) {
        return availableNoPatch;
      }

      var available = variantsList.find(function (variant) {
        return variant.available;
      });

      return available || variantsList[0];
    }

    function findMatchedVariant() {
      if (!allVisibleOptionsSelected()) {
        return null;
      }

      var selectedMap = getSelectedOptionsMap();

      var matches = variants.filter(function (variant) {
        return variantMatchesVisibleOptions(variant, selectedMap);
      });

      return preferVariant(matches);
    }

    function findPreviewVariant() {
      if (!hasAnySelection()) {
        return null;
      }

      var selectedMap = getSelectedOptionsMap();

      var matches = variants.filter(function (variant) {
        return variantMatchesVisibleOptions(variant, selectedMap);
      });

      return preferVariant(matches);
    }

    function updateOptionAvailability() {
      if (productHasOnlyDefaultVariant) {
        return;
      }

      var selectedMap = getSelectedOptionsMap();

      optionButtons.forEach(function (button) {
        var optionIndex = Number(button.getAttribute('data-option-position')) - 1;
        var candidateValue = button.getAttribute('data-option-value');
        var testMap = Object.assign({}, selectedMap);

        testMap[optionIndex] = candidateValue;

        var hasVariant = variants.some(function (variant) {
          return variantMatchesVisibleOptions(variant, testMap);
        });

        button.disabled = !hasVariant;
        button.classList.toggle('unavailable', !hasVariant);

        if (!hasVariant && button.classList.contains('active')) {
          button.classList.remove('active');
        }
      });
    }

    function updatePreviewPrice() {
      if (!priceBox || productHasOnlyDefaultVariant) {
        return;
      }

      var matchedVariant = findMatchedVariant();
      var previewVariant = findPreviewVariant();

      if (matchedVariant) {
        priceBox.textContent = formatPrice(matchedVariant.price);
        return;
      }

      if (previewVariant) {
        priceBox.textContent = formatPrice(previewVariant.price);
      }
    }

    function updateButtonState() {
      if (productHasOnlyDefaultVariant) {
        return;
      }

      updatePreviewPrice();

      var matchedVariant = findMatchedVariant();

      if (!allVisibleOptionsSelected()) {
        if (variantInput) {
          variantInput.value = '';
        }

        if (addButton) {
          addButton.disabled = true;
          addButton.textContent = 'בחר מידה';
        }

        if (requiredMessage) {
          requiredMessage.classList.remove('ready');
          requiredMessage.classList.remove('error');
          requiredMessage.textContent = 'יש לבחור מידה וסוג שרוול לפני הוספה לעגלה.';
        }

        return;
      }

      if (!matchedVariant) {
        if (variantInput) {
          variantInput.value = '';
        }

        if (addButton) {
          addButton.disabled = true;
          addButton.textContent = 'השילוב שבחרת לא זמין';
        }

        if (requiredMessage) {
          requiredMessage.classList.remove('ready');
          requiredMessage.classList.add('error');
          requiredMessage.textContent = 'השילוב שבחרת לא זמין. נסה לבחור אפשרות אחרת.';
        }

        return;
      }

      if (variantInput) {
        variantInput.value = matchedVariant.id;
      }

      if (priceBox) {
        priceBox.textContent = formatPrice(matchedVariant.price);
      }

      if (matchedVariant.available) {
        if (addButton) {
          addButton.disabled = false;
          addButton.textContent = 'הוסף לעגלה';
        }

        if (requiredMessage) {
          requiredMessage.classList.remove('error');
          requiredMessage.classList.add('ready');
          requiredMessage.textContent = 'מעולה, אפשר להוסיף לעגלה.';
        }
      } else {
        if (addButton) {
          addButton.disabled = true;
          addButton.textContent = 'אזל מהמלאי';
        }

        if (requiredMessage) {
          requiredMessage.classList.remove('ready');
          requiredMessage.classList.add('error');
          requiredMessage.textContent = 'האפשרות שבחרת אזלה מהמלאי.';
        }
      }
    }

    optionButtons.forEach(function (button) {
      button.addEventListener('click', function () {
        var position = button.getAttribute('data-option-position');
        var groupButtons = section.querySelectorAll('.ballers-option-btn[data-option-position="' + position + '"]');

        groupButtons.forEach(function (btn) {
          btn.classList.remove('active');
        });

        button.classList.add('active');

        if (requiredMessage) {
          requiredMessage.classList.remove('error');
        }

        updateOptionAvailability();
        updateButtonState();
      });
    });

    updateOptionAvailability();
    updateButtonState();

    if (productForm) {
      productForm.addEventListener('submit', function (event) {
        if (!productHasOnlyDefaultVariant && !allVisibleOptionsSelected()) {
          event.preventDefault();

          if (requiredMessage) {
            requiredMessage.classList.add('error');
            requiredMessage.textContent = 'לפני הוספה לעגלה חובה לבחור מידה וסוג שרוול.';
            requiredMessage.scrollIntoView({
              behavior: 'smooth',
              block: 'center'
            });
          }

          return false;
        }

        if (!productHasOnlyDefaultVariant && (!variantInput || variantInput.value === '')) {
          event.preventDefault();

          if (requiredMessage) {
            requiredMessage.classList.add('error');
            requiredMessage.textContent = 'השילוב שבחרת לא זמין. בחר אפשרויות אחרות.';
            requiredMessage.scrollIntoView({
              behavior: 'smooth',
              block: 'center'
            });
          }

          return false;
        }
      });
    }

    var thumbButtons = section.querySelectorAll('.ballers-thumb-btn');
    var thumbImages = section.querySelectorAll('.ballers-thumb-btn img');
    var mainImage = section.querySelector('.ballers-main-product-image');

    if (thumbButtons.length > 0) {
      thumbButtons[0].classList.add('active');
    }

    thumbImages.forEach(function (thumb) {
      thumb.addEventListener('click', function () {
        if (!mainImage) {
          return;
        }

        var newSrc = thumb.getAttribute('data-main-src');
        var newFull = thumb.getAttribute('data-full-src');

        thumbButtons.forEach(function (btn) {
          btn.classList.remove('active');
        });

        thumb.closest('.ballers-thumb-btn').classList.add('active');

        mainImage.style.opacity = '0';

        setTimeout(function () {
          mainImage.src = newSrc;
          mainImage.setAttribute('data-full-image', newFull);
          mainImage.style.opacity = '1';
        }, 200);
      });
    });

    var imageModal = document.getElementById('BallersImageModal');
    var modalImage = document.getElementById('BallersModalImage');
    var openImageButton = document.getElementById('BallersOpenImageModal');
    var imageModalClose = section.querySelector('.ballers-image-modal-close');

    if (openImageButton && imageModal && modalImage) {
      openImageButton.addEventListener('click', function () {
        var currentMainImage = section.querySelector('.ballers-main-product-image');

        if (!currentMainImage) {
          return;
        }

        modalImage.src = currentMainImage.getAttribute('data-full-image') || currentMainImage.src;
        imageModal.classList.add('open');
        document.body.style.overflow = 'hidden';
      });
    }

    if (imageModalClose && imageModal) {
      imageModalClose.addEventListener('click', function () {
        imageModal.classList.remove('open');
        document.body.style.overflow = '';
      });
    }

    if (imageModal) {
      imageModal.addEventListener('click', function (event) {
        if (event.target === imageModal) {
          imageModal.classList.remove('open');
          document.body.style.overflow = '';
        }
      });
    }

    var modalKids = document.getElementById('BallersSizeModalKids');
    var modalMature = document.getElementById('BallersSizeModalMature');
    var sizeButtons = section.querySelectorAll('[data-size-modal]');
    var closeButtons = document.querySelectorAll('.ballers-size-close');

    sizeButtons.forEach(function (button) {
      button.addEventListener('click', function () {
        var type = button.getAttribute('data-size-modal');

        if (type === 'kids' && modalKids) {
          modalKids.classList.add('open');
        }

        if (type === 'mature' && modalMature) {
          modalMature.classList.add('open');
        }
      });
    });

    closeButtons.forEach(function (button) {
      button.addEventListener('click', function () {
        var modal = button.closest('.ballers-size-modal') || button.closest('.ballers-image-modal');

        if (modal) {
          modal.classList.remove('open');
          document.body.style.overflow = '';
        }
      });
    });

    [modalKids, modalMature].forEach(function (modal) {
      if (!modal) {
        return;
      }

      modal.addEventListener('click', function (event) {
        if (event.target === modal) {
          modal.classList.remove('open');
        }
      });
    });

    document.addEventListener('keydown', function (event) {
      if (event.key === 'Escape') {
        if (imageModal) {
          imageModal.classList.remove('open');
          document.body.style.overflow = '';
        }

        document.querySelectorAll('.ballers-size-modal.open').forEach(function (modal) {
          modal.classList.remove('open');
        });
      }
    });
  });
</script>

