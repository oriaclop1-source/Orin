{%- comment -%}
  Sale banner with a countdown for the Shopify theme.
  Install: Online Store -> Themes -> ... -> Edit code -> Sections -> Add a new section
  named "promo-banner", paste this file, Save. Then Customize -> Add section -> "באנר מבצע".
  Before `starts` it counts down to the sale, until `ends` it counts down to the end,
  after that it hides itself.
{%- endcomment -%}

{%- if section.settings.enabled -%}
<aside class="pj-promo" id="pj-promo-{{ section.id }}" dir="rtl" hidden
  data-starts="{{ section.settings.starts | escape }}"
  data-ends="{{ section.settings.ends | escape }}"
  data-before="{{ section.settings.text_before | escape }}"
  data-during="{{ section.settings.text_during | escape }}">
  <div class="pj-promo__text">
    <strong>{{ section.settings.title | escape }}</strong>
    <span data-pj-text></span>
  </div>
  <div class="pj-promo__clock" role="timer">
    <span class="pj-promo__label" data-pj-label></span>
    <span class="pj-promo__unit"><b data-pj-unit>00</b><small>ימים</small></span>
    <span class="pj-promo__unit"><b data-pj-unit>00</b><small>שעות</small></span>
    <span class="pj-promo__unit"><b data-pj-unit>00</b><small>דקות</small></span>
    <span class="pj-promo__unit"><b data-pj-unit>00</b><small>שניות</small></span>
  </div>
  {%- if section.settings.link != blank -%}
    <a class="pj-promo__link" href="{{ section.settings.link }}">{{ section.settings.link_text | escape }}</a>
  {%- endif -%}
</aside>

<style>
  #pj-promo-{{ section.id }} {
    display: flex; flex-wrap: wrap; align-items: center; justify-content: center;
    gap: 10px 24px; padding: 12px 16px; background: #0b0b0d; color: #fff;
    font-family: "Rubik", "Heebo", Arial, sans-serif; text-align: center;
  }
  #pj-promo-{{ section.id }}[hidden] { display: none; }
  #pj-promo-{{ section.id }}.pj-promo--live {
    background: #0b0b0d linear-gradient(90deg, rgba(246,201,14,.16), transparent 30%, transparent 70%, rgba(246,201,14,.16));
  }
  #pj-promo-{{ section.id }} .pj-promo__text { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: center; gap: 4px 12px; }
  #pj-promo-{{ section.id }} .pj-promo__text strong { color: #f6c90e; font-size: 22px; font-weight: 900; letter-spacing: .06em; direction: ltr; }
  #pj-promo-{{ section.id }} .pj-promo__text span { font-size: 15px; font-weight: 500; }
  #pj-promo-{{ section.id }} .pj-promo__clock { display: flex; align-items: center; gap: 6px; }
  #pj-promo-{{ section.id }} .pj-promo__label { margin-inline-end: 4px; font-size: 13px; color: rgba(255,255,255,.75); }
  #pj-promo-{{ section.id }} .pj-promo__unit {
    display: flex; flex-direction: column; align-items: center; min-width: 46px; padding: 5px 4px 4px;
    border: 1px solid rgba(246,201,14,.45); border-radius: 6px; background: #17171b;
  }
  #pj-promo-{{ section.id }} .pj-promo__unit b { font-size: 20px; font-weight: 800; line-height: 1; font-variant-numeric: tabular-nums; color: #fff; }
  #pj-promo-{{ section.id }} .pj-promo__unit small { margin-top: 3px; font-size: 10px; color: rgba(255,255,255,.7); }
  #pj-promo-{{ section.id }} .pj-promo__link {
    padding: 9px 18px; border-radius: 999px; background: #f6c90e; color: #0b0b0d;
    font-size: 14px; font-weight: 800; text-decoration: none;
  }
  #pj-promo-{{ section.id }} .pj-promo__link:hover,
  #pj-promo-{{ section.id }} .pj-promo__link:focus-visible { background: #fff; }
  @media (max-width: 520px) {
    #pj-promo-{{ section.id }} .pj-promo__text strong { font-size: 19px; }
    #pj-promo-{{ section.id }} .pj-promo__unit { min-width: 42px; }
    #pj-promo-{{ section.id }} .pj-promo__clock { flex-wrap: wrap; justify-content: center; }
    #pj-promo-{{ section.id }} .pj-promo__label { width: 100%; margin: 0; }
  }
</style>

<script>
  (function () {
    var box = document.getElementById('pj-promo-{{ section.id }}');
    if (!box) { return; }
    var starts = new Date(box.dataset.starts).getTime();
    var ends = new Date(box.dataset.ends).getTime();
    if (isNaN(starts) || isNaN(ends)) { return; }
    var text = box.querySelector('[data-pj-text]');
    var label = box.querySelector('[data-pj-label]');
    var units = box.querySelectorAll('[data-pj-unit]');
    var clock = box.querySelector('[role=timer]');
    var timer;
    function pad(n) { return n < 10 ? '0' + n : String(n); }
    function tick() {
      var now = Date.now();
      if (now >= ends) { box.hidden = true; clearInterval(timer); return; }
      var live = now >= starts;
      box.classList.toggle('pj-promo--live', live);
      text.textContent = live ? box.dataset.during : box.dataset.before;
      label.textContent = live ? 'נגמר בעוד' : 'מתחיל בעוד';
      clock.setAttribute('aria-label', live ? 'הזמן שנשאר למבצע' : 'הזמן עד תחילת המבצע');
      var left = Math.floor(((live ? ends : starts) - now) / 1000);
      var parts = [Math.floor(left / 86400), Math.floor(left % 86400 / 3600), Math.floor(left % 3600 / 60), left % 60];
      for (var i = 0; i < units.length; i++) { units[i].textContent = pad(parts[i]); }
      box.hidden = false;
    }
    tick();
    timer = setInterval(tick, 1000);
  })();
</script>
{%- endif -%}

{% schema %}
{
  "name": "באנר מבצע",
  "tag": "section",
  "class": "pj-promo-section",
  "settings": [
    { "type": "checkbox", "id": "enabled", "label": "להציג את הבאנר", "default": true },
    { "type": "text", "id": "title", "label": "כותרת", "default": "BLACK FRIDAY" },
    { "type": "text", "id": "text_before", "label": "טקסט לפני המבצע", "default": "בלאק פריידיי מתחיל ביום שישי 27.11" },
    { "type": "text", "id": "text_during", "label": "טקסט בזמן המבצע", "default": "3+1 מתנה על כל האתר + משלוח חינם" },
    { "type": "text", "id": "starts", "label": "תחילת המבצע", "info": "בפורמט 2026-11-27T00:00:00+02:00", "default": "2026-11-27T00:00:00+02:00" },
    { "type": "text", "id": "ends", "label": "סוף המבצע", "info": "בפורמט 2026-11-30T23:59:59+02:00. אחרי התאריך הזה הבאנר נעלם", "default": "2026-11-30T23:59:59+02:00" },
    { "type": "url", "id": "link", "label": "קישור הכפתור", "default": "/collections/all" },
    { "type": "text", "id": "link_text", "label": "טקסט הכפתור", "default": "לקולקציה" }
  ],
  "presets": [{ "name": "באנר מבצע" }]
}
{% endschema %}
